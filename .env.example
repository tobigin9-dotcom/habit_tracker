# Copy to .env and fill in secrets. Never commit .env.
POSTGRES_DB=habits
POSTGRES_USER=habits_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql+asyncpg://habits_user:replace_with_a_long_random_password@db:5432/habits
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BOT_TOKEN=123456:replace_with_token_from_BotFather
BOT_API_TOKEN=replace_with_a_separate_long_random_internal_api_token
API_BASE_URL=http://api:8000
DEFAULT_REMINDER_TIME=20:00
HABIT_TARGET_COMPLETIONS=21
TIMEZONE=Europe/Amsterdam
